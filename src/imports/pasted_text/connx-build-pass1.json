  --dark-matter: #373A40;
  --lunar-mist: #F6F9FD;
  --white: #FFFFFF;
  --nebula-green: #48E29A;
  --nebula-green-ink: #16883D;
  --solar-flare: #C8FF73;
  --quantum-purple: #7717C7;
  --galactic-violet: #B030FF;

  --border: #E8EBF0;
