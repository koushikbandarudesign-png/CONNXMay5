export type ConsentStatus = "pending" | "accepted" | "declined" | "expired" | "scheduled";

export type CallDisposition = "shortlisted" | "rejected" | "on-hold" | "callback" | null;

export type CallStatus =
  | "pending"
  | "dialing"
  | "connected"
  | "voicemail-dropped"
  | "completed"
  | "no-answer"
  | "failed";

export type RoleStage = "shortlisted" | "consented" | "screened" | "advanced" | "rejected";

export type Persona = "recruiter" | "hm" | "lead";

export type Panel = "metadata" | "resume" | "questions" | "notes" | "jd";
export type Zone = "A" | "B" | "C";
export type LayoutPref = Record<Zone, Panel>;

export interface Candidate {
  id: string;
  name: string;
  email: string;
  phone: string;
  currentRole: string;
  currentCompany: string;
  location: string;
  source: "Workday" | "Greenhouse" | "Lever" | "iCIMS" | "Manual";
  shortlistedAt: string;       // ISO
  consentStatus: ConsentStatus;
  consentSentAt?: string;
  consentRespondedAt?: string;
  scheduledCallAt?: string;
  yearsExperience: number;
  skills: string[];
  resumeSummary: string;
  resumeBullets: string[];
  lastDisposition?: CallDisposition;
  lastCallAt?: string;
  callbackAt?: string;          // for callback tracker
  roleId: string;
  stage: RoleStage;
  notes?: string;
  aiSummary?: string;
}

export interface Role {
  id: string;
  title: string;
  team: string;
  hiringManager: string;
  recruiter: string;
  location: string;
  openedAt: string;
  targetCount: number;
  shortlisted: number;
  consented: number;
  screened: number;
  advanced: number;
  rejected: number;
  screeningQuestions: ScreeningQuestion[];
  jdSummary: string;
  jdFull: string;
}

export interface ScreeningQuestion {
  id: string;
  question: string;
  type: "open" | "yes-no" | "rating";
