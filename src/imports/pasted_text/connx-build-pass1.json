export interface TimelineEvent {
  id: string;
  candidateId: string;
  type: "consent-sent" | "consent-accepted" | "consent-declined" | "call" | "voicemail" | "sms" | "email" | "note" | "stage-change";
  at: string;
  by?: string;
  content: string;
  meta?: Record<string, any>;
}

export interface Recruiter {
  id: string;
  name: string;
  email: string;
  team: string;
