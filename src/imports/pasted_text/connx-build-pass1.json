import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "@/lib/utils";

const badgeVariants = cva(
  "inline-flex items-center gap-1 rounded-pill px-2 py-0.5 t-label-small whitespace-nowrap",
  {
    variants: {
      variant: {
        default: "bg-mist text-cosmic",
        success: "bg-success-soft text-success-ink",
        warning: "bg-warning-soft text-warning-ink",
        danger: "bg-danger-soft text-danger-ink",
        info: "bg-stellar-50 text-stellar-700",
        neutral: "bg-mist text-dark",
        outline: "bg-white border border-border text-dark",
        cosmic: "bg-cosmic text-white",
        flare: "bg-flare text-cosmic", // Solar Flare: bg only — never text on white
      },
      size: {
        default: "px-2 py-0.5",
        sm: "px-1.5 py-0 text-[9px]",
        lg: "px-2.5 py-1 text-[11px]",
      },
    },
    defaultVariants: { variant: "default", size: "default" },
  }
);

export interface BadgeProps
  extends React.HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof badgeVariants> {}

export function Badge({ className, variant, size, ...props }: BadgeProps) {
  return <div className={cn(badgeVariants({ variant, size }), className)} {...props} />;
}
