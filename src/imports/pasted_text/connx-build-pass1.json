}

export interface CallEvent {
  id: string;
  candidateId: string;
  roleId: string;
  startedAt: string;
  endedAt?: string;
  durationSec?: number;
  status: CallStatus;
  disposition?: CallDisposition;
  voicemailDropped?: boolean;
  recordingUrl?: string;
