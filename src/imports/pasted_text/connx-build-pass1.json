function rand<T>(arr: T[]): T { return arr[Math.floor(Math.random() * arr.length)]; }
function pick<T>(arr: T[], n: number): T[] {
  const c = [...arr]; const out: T[] = [];
  for (let i = 0; i < n && c.length; i++) out.push(c.splice(Math.floor(Math.random() * c.length), 1)[0]);
  return out;
}

const SKILLS_BY_TEAM: Record<string, string[]> = {
  Platform: ["Go", "Rust", "Kubernetes", "Kafka", "NATS", "Postgres", "gRPC", "Terraform", "AWS", "GCP", "Distributed systems", "Observability"],
  Product: ["Figma", "Design systems", "User research", "Prototyping", "B2B SaaS", "Industrial UX", "Cross-functional leadership", "Mentorship"],
  Data: ["PyTorch", "JAX", "Time-series forecasting", "Causal inference", "MLOps", "Spark", "dbt", "Snowflake", "Bayesian methods"],
  Sales: ["Enterprise sales", "MEDDPICC", "Outbound", "Channel partnerships", "Six-figure ACV", "Multi-stakeholder selling"],
};

function dateAgo(days: number): string {
  const d = new Date();
  d.setDate(d.getDate() - days);
  d.setHours(d.getHours() - Math.floor(Math.random() * 12));
  return d.toISOString();
}

function dateAhead(hours: number): string {
  const d = new Date();
  d.setHours(d.getHours() + hours + Math.floor(Math.random() * 24));
  return d.toISOString();
}

let candidateIdCounter = 1000;

function generateCandidate(role: Role, stageHint?: Candidate["stage"]): Candidate {
  const first = rand(FIRST_NAMES);
  const last = rand(LAST_NAMES);
  const id = `cand-${++candidateIdCounter}`;
  const skills = pick(SKILLS_BY_TEAM[role.team] || SKILLS_BY_TEAM.Platform, 5 + Math.floor(Math.random() * 3));
  const yearsExp = role.title.includes("Staff") || role.title.includes("Senior") || role.title.includes("Manager")
    ? 6 + Math.floor(Math.random() * 8)
    : 3 + Math.floor(Math.random() * 5);

  const stages: Candidate["stage"][] = ["shortlisted", "consented", "screened", "advanced", "rejected"];
  const stage = stageHint ?? rand(stages);

  let consentStatus: Candidate["consentStatus"] = "pending";
  let lastDisposition: Candidate["lastDisposition"] = null;

  if (stage === "shortlisted") consentStatus = rand(["pending", "pending", "expired"] as const);
  else if (stage === "consented") consentStatus = "accepted";
  else if (stage === "screened") { consentStatus = "accepted"; lastDisposition = "on-hold"; }
  else if (stage === "advanced") { consentStatus = "accepted"; lastDisposition = "shortlisted"; }
  else if (stage === "rejected") { consentStatus = rand(["accepted", "declined"] as const); lastDisposition = "rejected"; }

  const shortlistedDay = Math.floor(Math.random() * 14) + 1;

  return {
    id,
    name: `${first} ${last}`,
    email: `${first.toLowerCase()}.${last.toLowerCase()}@${rand(["gmail.com", "outlook.com", "hey.com", "fastmail.com", "proton.me"])}`,
    phone: `+1 ${200 + Math.floor(Math.random() * 800)} ${100 + Math.floor(Math.random() * 900)} ${1000 + Math.floor(Math.random() * 9000)}`,
    currentRole: role.title.replace("Senior ", "").replace("Staff ", "").replace("Lead ", ""),
    currentCompany: rand(COMPANIES),
    location: rand(LOCATIONS),
    source: rand(["Workday", "Greenhouse", "Lever", "iCIMS"] as const),
    shortlistedAt: dateAgo(shortlistedDay),
    consentStatus,
    consentSentAt: dateAgo(shortlistedDay - 0.1),
    consentRespondedAt: consentStatus === "accepted" || consentStatus === "declined" ? dateAgo(shortlistedDay - 1) : undefined,
    yearsExperience: yearsExp,
    skills,
    resumeSummary: `${yearsExp}-year ${role.team.toLowerCase()} ${role.title.includes("Manager") ? "leader" : "engineer"} most recently at ${COMPANIES[Math.floor(Math.random() * COMPANIES.length)]}, with deep experience in ${skills.slice(0, 2).join(" and ")}.`,
    resumeBullets: [
      `Led ${role.team === "Platform" ? "platform reliability" : role.team === "Data" ? "forecasting infra" : role.team === "Product" ? "product design" : "enterprise expansion"} for a ${rand(["50", "200", "400", "1000"])}-person company.`,
      `Owned ${rand(["a 4-person team", "a 6-person team", "individual contributor track"])} for ${2 + Math.floor(Math.random() * 4)} years.`,
      `Specialised in ${skills.slice(0, 3).join(", ")}.`,
      `Prior experience: ${pick(COMPANIES, 2).join(", ")}.`,
    ],
    lastDisposition,
    lastCallAt: stage === "screened" || stage === "advanced" || stage === "rejected" ? dateAgo(Math.floor(Math.random() * 5)) : undefined,
    callbackAt: consentStatus === "accepted" && stage === "consented" && Math.random() < 0.3 ? dateAhead(Math.floor(Math.random() * 48) - 24) : undefined,
    roleId: role.id,
    stage,
    aiSummary: stage === "screened" || stage === "advanced"
      ? `Strong fundamentals in ${skills[0]} and ${skills[1]}. Communicates clearly, asked thoughtful questions about team structure and on-call expectations. Comp expectation: $${180 + Math.floor(Math.random() * 80)}k base. Earliest start: ${rand(["2 weeks", "4 weeks", "6 weeks"])}. ${rand(["Recommend advance to onsite.", "Recommend technical screen.", "Strong yes — move forward.", "Borderline — would benefit from a second screen."])}`
      : undefined,
  };
}

// Generate candidate pool deterministically distributed across stages
export const CANDIDATES: Candidate[] = ROLES.flatMap(role => {
  const out: Candidate[] = [];
  for (let i = 0; i < role.shortlisted - role.consented; i++) out.push(generateCandidate(role, "shortlisted"));
  for (let i = 0; i < role.consented - role.screened; i++) out.push(generateCandidate(role, "consented"));
  for (let i = 0; i < role.screened - role.advanced - role.rejected; i++) out.push(generateCandidate(role, "screened"));
  for (let i = 0; i < role.advanced; i++) out.push(generateCandidate(role, "advanced"));
  for (let i = 0; i < role.rejected; i++) out.push(generateCandidate(role, "rejected"));
  return out;
});

