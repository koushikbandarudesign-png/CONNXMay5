import * as React from "react";
import { Slot } from "@radix-ui/react-slot";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "@/lib/utils";

const buttonVariants = cva(
  "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-semibold transition-all focus-visible:outline-none focus-visible:shadow-focus disabled:pointer-events-none disabled:opacity-50 active:scale-[0.98]",
  {
    variants: {
      variant: {
        // Primary CTA — Stellar Blue
        default: "bg-stellar text-white hover:bg-stellar-700",
        // Secondary outline
        outline: "bg-white border border-border-strong text-dark hover:bg-mist hover:border-stellar/50",
        // Ghost
        ghost: "text-dark hover:bg-mist",
        // Subtle (mist background)
        subtle: "bg-mist text-cosmic hover:bg-stellar-50",
        // Destructive — semantic red, never brand red
        destructive: "bg-danger text-white hover:bg-danger-ink",
        // Brand — Cosmic Indigo (for hero CTAs only)
        brand: "bg-cosmic text-white hover:bg-cosmic/90",
        // Link
        link: "text-stellar hover:underline underline-offset-4",
        // Success
        success: "bg-success text-success-ink hover:bg-success/80",
      },
      size: {
        default: "h-9 px-4 text-[14px]",
        sm: "h-8 px-3 text-[13px] rounded-md",
        lg: "h-10 px-5 text-[14px]",
        xl: "h-12 px-6 text-[15px]",
        icon: "h-9 w-9",
        "icon-sm": "h-8 w-8",
      },
    },
    defaultVariants: { variant: "default", size: "default" },
  }
);

export interface ButtonProps
  extends React.ButtonHTMLAttributes<HTMLButtonElement>,
    VariantProps<typeof buttonVariants> {
  asChild?: boolean;
}

export const Button = React.forwardRef<HTMLButtonElement, ButtonProps>(
  ({ className, variant, size, asChild = false, ...props }, ref) => {
    const Comp = asChild ? Slot : "button";
    return <Comp className={cn(buttonVariants({ variant, size, className }))} ref={ref} {...props} />;
  }
);
Button.displayName = "Button";

export { buttonVariants };
<<< END FILE

