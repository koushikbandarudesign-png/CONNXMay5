import { useEffect, useState } from "react";
import { Sparkles, TrendingUp, PhoneCall, Users, Target, ArrowRight } from "lucide-react";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { CURRENT_RECRUITER, TODAY_METRICS, GOALS, ORG } from "@/data/mock";
import { cn } from "@/lib/utils";

export default function DashboardPage() {
  // Greeting that reflects time of day — small touch of warmth from the design language
  const hour = new Date().getHours();
  const greeting = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
  const firstName = CURRENT_RECRUITER.name.split(" ")[0];

  return (
    <div className="p-6 lg:p-8 max-w-[1200px] mx-auto">
      {/* Greeting */}
      <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-6">
        <div>
          <h1 className="mb-1">{greeting}, {firstName}</h1>
          <p className="text-muted-fg t-body-large">Here's what's happening across your roles today.</p>
        </div>
        <div className="flex items-center gap-2">
          <Button variant="outline" size="sm">
            <PhoneCall className="h-3.5 w-3.5" /> Resume last queue
          </Button>
          <Button size="sm">
            <PhoneCall className="h-3.5 w-3.5" /> Start dialer
          </Button>
        </div>
      </div>

      {/* Quick metrics */}
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <MetricCard label="Calls made today" value={TODAY_METRICS.callsMade} delta="+12%" trend="up" icon={PhoneCall} />
        <MetricCard label="Connect rate" value={`${Math.round(TODAY_METRICS.connectRate * 100)}%`} delta="+4%" trend="up" icon={TrendingUp} />
        <MetricCard label="Screenings done" value={TODAY_METRICS.screeningsCompleted} delta={`${TODAY_METRICS.shortlisted} shortlisted`} icon={Users} />
        <MetricCard
          label="Daily goal"
          value={`${GOALS.daily.actual}/${GOALS.daily.target}`}
          delta={`${Math.round((GOALS.daily.actual / GOALS.daily.target) * 100)}% there`}
          icon={Target}
        />
      </div>

      {/* Foundation verification card */}
      <Card>
        <CardContent className="p-6">
          <div className="flex items-start gap-4">
            <div className="leo-gradient rounded-lg p-2.5 shrink-0">
              <Sparkles className="h-5 w-5 text-white" />
            </div>
            <div className="flex-1">
              <div className="flex items-center gap-2 mb-1">
                <h5>Foundation ready</h5>
                <Badge variant="success">Pass 1 of 8</Badge>
              </div>
              <p className="text-muted-fg mb-4">
                Design tokens, layout shell, sidebar, top bar, persona switcher, and ⌘K command palette are wired up. Try the persona switcher in the top right — sidebar nav adapts per role. Press ⌘K to open the natural-language command bar.
              </p>
              <div className="flex flex-wrap gap-2">
                <Badge variant="info">Cosmic Indigo · Stellar Blue · Lunar Mist</Badge>
                <Badge variant="info">M3 type scale</Badge>
                <Badge variant="info">4px spacing grid</Badge>
                <Badge variant="info">Lucide icons</Badge>
                <Badge variant="info">Cool shadows</Badge>
              </div>
            </div>
          </div>
        </CardContent>
      </Card>

      <p className="t-body-small text-muted-fg text-center mt-8">
        {ORG.name} · {ORG.industry} · {ORG.size}
      </p>
    </div>
  );
}

function MetricCard({
  label, value, delta, trend, icon: Icon,
}: {
  label: string; value: string | number; delta?: string; trend?: "up" | "down"; icon: React.ComponentType<{ className?: string }>;
}) {
  return (
    <Card>
      <CardContent className="p-5">
        <div className="flex items-center justify-between mb-3">
          <Icon className="h-4 w-4 text-muted-fg" />
          {delta && trend && (
            <Badge variant={trend === "up" ? "success" : "danger"} size="sm" className="gap-0.5">
              <TrendingUp className={cn("h-2.5 w-2.5", trend === "down" && "rotate-180")} />
              {delta}
            </Badge>
          )}
          {delta && !trend && <span className="t-body-small text-muted-fg">{delta}</span>}
        </div>
        <div className="t-display-small text-cosmic mb-1 tabular-nums">{value}</div>
        <div className="t-body-small text-muted-fg">{label}</div>
      </CardContent>
    </Card>
  );
}
