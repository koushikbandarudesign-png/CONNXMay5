import { createBrowserRouter, RouterProvider, Navigate } from "react-router-dom";
import { AppShell } from "@/components/layout/app-shell";
import { PagePlaceholder } from "@/components/connx/page-placeholder";
import DashboardPage from "@/pages/recruiter/dashboard";

const router = createBrowserRouter([
  {
    path: "/",
    element: <AppShell />,
    children: [
      // Recruiter
      { index: true, element: <DashboardPage /> },
      { path: "roles", element: <PagePlaceholder title="Roles & candidates" description="6 open roles · 142 candidates in flight" /> },
      { path: "roles/:roleId", element: <PagePlaceholder title="Role detail" /> },
      { path: "consent", element: <PagePlaceholder title="Consent center" description="Track consent status across all candidates and roles" /> },
      { path: "dialer", element: <PagePlaceholder title="Auto Dialer" description="The hero flow — queue builder, customise call view, active call" /> },
      { path: "bulk", element: <PagePlaceholder title="Bulk communication" description="SMS, email, and WhatsApp campaigns" /> },
      { path: "timeline", element: <PagePlaceholder title="Candidate timeline" /> },
      { path: "candidates/:id", element: <PagePlaceholder title="Candidate profile" /> },
      { path: "templates", element: <PagePlaceholder title="Templates library" /> },

      // Hiring Manager
      { path: "hm", element: <PagePlaceholder title="Pipeline" description="Read-only view of all your open roles" /> },
      { path: "hm/candidates/:id", element: <PagePlaceholder title="Candidate review" /> },
      { path: "hm/approvals", element: <PagePlaceholder title="Approvals queue" /> },
      { path: "hm/digest", element: <PagePlaceholder title="Daily digest" /> },

      // Recruitment Lead
      { path: "lead", element: <PagePlaceholder title="Team analytics" /> },
      { path: "lead/leaderboard", element: <PagePlaceholder title="Leaderboard" /> },
      { path: "lead/goals", element: <PagePlaceholder title="Goals & SLAs" /> },
      { path: "lead/team", element: <PagePlaceholder title="Team members" /> },

      // Shared
      { path: "settings", element: <PagePlaceholder title="Settings" /> },
      { path: "integrations", element: <PagePlaceholder title="Integrations" /> },

      // Catchall
      { path: "*", element: <Navigate to="/" replace /> },
    ],
  },
]);

export function AppRouter() {
  return <RouterProvider router={router} />;
}
